---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = await getCollection("blog", ({ data }) => !data.draft);
---

<Layout title={`Archives | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Archives" pageDesc="All the articles I've archived.">
    {
      Object.entries(
        getPostsByGroupCondition(posts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div class="mb-8">
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-sm">{yearGroup.length}</sup>
            <ul class="mt-4 space-y-2">
              {yearGroup
                .sort(
                  (a, b) =>
                    Math.floor(
                      new Date(b.data.pubDatetime).getTime() / 1000
                    ) -
                    Math.floor(
                      new Date(a.data.pubDatetime).getTime() / 1000
                    )
                )
                .map((post) => {
                  const { title } = post.data;
                  return (
                    <li>
                      <a
                        href={getPath(post.id, post.filePath, post.data.pubDatetime, title)}
                        class="text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
                      >
                        <span
                          style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
                        >
                          {title}
                        </span>
                      </a>
                    </li>
                  );
                })}
            </ul>
          </div>
        ))
    }
  </Main>
  <Footer />
</Layout>
